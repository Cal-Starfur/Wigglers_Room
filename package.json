    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devvit/public-api": "^0.11.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "@types/node": "^20.0.0"
  }
}
