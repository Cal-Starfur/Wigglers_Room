{
  "name": "wigglers-room",
  "version": "0.2.0",
  "private": true,
  "description": "A wiggly multiplayer room game on Reddit via Devvit",
  "scripts": {
    "build": "tsc --noEmit && devvit build",
    "dev": "devvit upload && devvit playtest",
